# ==============================================================================
# RESQNET Environment Configuration (Example template)
# COPY TO .env FOR LOCAL DEVELOPMENT - DO NOT COMMIT SENSITIVE VALUES
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=RESQNET
PROJECT_VERSION=0.1.0
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-long

# Server Host & Port
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8001
FRONTEND_PORT=5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database (PostgreSQL with PostGIS)
# Local docker-compose defaults:
DATABASE_URL=postgresql://resqnet_user:resqnet_password@postgres:5432/resqnet_db
# For running tests or local scripts outside docker compose:
# DATABASE_URL=postgresql://resqnet_user:resqnet_password@localhost:5433/resqnet_db

POSTGRES_USER=resqnet_user
POSTGRES_PASSWORD=resqnet_password
POSTGRES_DB=resqnet_db
POSTGRES_PORT=5433


# AWS Integration Boundaries (Set USE_AWS_SERVICES=false for local mock mode)
USE_AWS_SERVICES=false
AWS_REGION=us-east-1

# Amazon Cognito (Optional for local dev mode; required for prod)
COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_APP_CLIENT_ID=exampleappclientid12345
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_examplepool/.well-known/jwks.json

# Amazon S3 for Attachments
S3_ATTACHMENT_BUCKET_NAME=resqnet-incident-attachments-dev
S3_PRESIGNED_EXPIRY_SECONDS=900

# Amazon SNS for Emergency Notifications
SNS_DISPATCH_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:resqnet-dispatch-alerts-dev

# CloudWatch Logging
CLOUDWATCH_LOG_GROUP=/resqnet/backend-dev

# Frontend API URL (FastAPI/PostgreSQL backend — ops dashboard)
VITE_API_BASE_URL=http://localhost:8001/api

# Serverless Citizen SOS API URL (AWS SAM local: sam local start-api --port 3000)
# In production: replace with the API Gateway stage URL from CloudFormation outputs
VITE_SERVERLESS_API_URL=http://localhost:3000
