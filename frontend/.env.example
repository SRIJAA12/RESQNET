# Backend FastAPI (local Docker container mapped to port 8001)
VITE_API_BASE_URL=http://localhost:8001/api

# AWS Serverless Citizen SOS Pipeline
# Option 1: Live deployed API (shared sandbox)
VITE_SERVERLESS_API_URL=https://ncwcst8z63.execute-api.eu-west-1.amazonaws.com/v1

# Option 2: Local SAM mock (if running `sam local start-api --port 3000`)
# VITE_SERVERLESS_API_URL=http://localhost:3000
